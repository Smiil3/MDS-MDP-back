# Database
DATABASE_URL="mysql://root:password@localhost:3306/express_prisma_api"

# Server
PORT=3000

# Auth
JWT_SECRET="replace-with-access-token-secret"
JWT_EXPIRES_IN="3h"
JWT_REFRESH_SECRET="replace-with-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_DEFAULT_SUBSCRIPTION=1

# Geocoding (Nominatim — optionnel, valeurs par défaut suffisantes)
GEOCODING_NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
GEOCODING_USER_AGENT="MDS-MDP-back/1.0"
GEOCODING_EMAIL=""

# Location — BAN (suggestions d'adresses françaises)
BAN_API_BASE_URL="https://api-adresse.data.gouv.fr"

# Location — SIRET via INPI (optionnel — laisser vide pour utiliser le fallback gratuit)
INPI_API_BASE_URL=""
INPI_API_TOKEN=""

# Location — Recherche entreprises (fallback SIRET sans compte — optionnel, valeur par défaut suffisante)
RECHERCHE_ENTREPRISES_API_URL="https://recherche-entreprises.api.gouv.fr/search"
